<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- INPUT URL SCREEN CONTAINER -->
    <ScrollView
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- App Logo / Icon Header -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="16dp"
                android:src="@android:drawable/ic_menu_compass"
                app:tint="#10B981" />

            <!-- Main Input Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="12dp"
                android:orientation="vertical"
                android:padding="28dp">

                <!-- Title requested by user -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alignmentMode="alignBounds"
                    android:gravity="center"
                    android:text="@string/title_prompt"
                    android:textColor="#F8FAFC"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:text="@string/subtitle_prompt"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <!-- Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="ĐƯỜNG DẪN / IP SỐ:"
                    android:textColor="#10B981"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- EditText Input Field -->
                <EditText
                    android:id="@+id/etUrlInput"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/url_hint"
                    android:inputType="textUri"
                    android:paddingHorizontal="16dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="15sp" />

                <!-- Quick Presets for fast entry -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="20dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipHttp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:text="http://"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipLocal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:text=":3000"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipHttps"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:text="https://"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Checkbox to Remember URL -->
                <CheckBox
                    android:id="@+id/cbRemember"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:checked="true"
                    android:text="Ghi nhớ địa chỉ cho lần sau"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    app:buttonTint="#10B981" />

                <!-- Action Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnConnect"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_btn_gradient"
                    android:text="@string/btn_connect"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Footer note -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Hệ Thống Quản Lý Vườn Rau Thông Minh"
                android:textColor="#64748B"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

    <!-- WEBVIEW SCREEN CONTAINER -->
    <LinearLayout
        android:id="@+id/webViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Loading ProgressBar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:progressTint="#10B981"
            android:visibility="gone" />

        <!-- WebView -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

</RelativeLayout>
